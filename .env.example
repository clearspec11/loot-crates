# Settings for `npm run live` (scripts/live.mjs). Copy to .env, which git ignores.
# The dev world the live checks join. Its Gamemaster must have no password,
# and nobody may be logged in while a check runs (the checks take the seats).
FOUNDRY_URL=http://<foundry host>:30000
# Where this checkout's module/ is served with CORS (`npm run foundry:serve`),
# as the Foundry host reaches this machine.
MODULE_BASE=http://<this machine>:8766/
# The player account that owns the test character (default Player2).
# PLAYER=Player2
